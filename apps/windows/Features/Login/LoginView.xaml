<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer Background="Transparent">
    <StackPanel Orientation="Horizontal" Spacing="72" Padding="48" HorizontalAlignment="Center">

      <StackPanel Spacing="20" MaxWidth="390" VerticalAlignment="Center">
        <SymbolIcon
            Symbol="Comment"
            Width="44"
            Height="44"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Text="Un espace pour&#x0a;vos conversations." FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock
            Text="Vos communautés, vos idées et vos échanges.&#x0a;Une expérience pensée pour Windows."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBlock
            Text="WinUI 3 + Rust"
            FontSize="13"
            Margin="0,12,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <!-- A Border, not a StackPanel, owns the rounded card: panels have no CornerRadius. -->
      <Border
          Width="340"
          VerticalAlignment="Center"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="16">
        <StackPanel Spacing="16" Padding="28">
          <TextBlock Text="Bienvenue" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Retrouvez votre communauté." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="ModeLogin" Content="Connexion" GroupName="mode" IsChecked="True" Checked="OnModeChanged" />
            <RadioButton x:Name="ModeCreate" Content="Créer un compte" GroupName="mode" Checked="OnModeChanged" />
          </StackPanel>

          <TextBox x:Name="BaseUrl" Header="Adresse du serveur" Text="http://localhost:3000" />
          <TextBox x:Name="Username" Header="Nom d’utilisateur" Visibility="Collapsed" />
          <TextBox x:Name="Identifier" Header="Identifiant" PlaceholderText="vous@exemple.fr" />
          <PasswordBox x:Name="Password" Header="Mot de passe" />

          <Button
              x:Name="Submit"
              Content="Se connecter"
              HorizontalAlignment="Stretch"
              Style="{ThemeResource AccentButtonStyle}"
              Click="OnSubmit" />
          <Button
              x:Name="Demo"
              Content="Ouvrir la démo"
              HorizontalAlignment="Stretch"
              Click="OnDemo" />
          <ProgressRing x:Name="Busy" Width="20" Height="20" HorizontalAlignment="Left" IsActive="False" />
          <TextBlock
              x:Name="Hint"
              Text="Connectez-vous au backend. La session reste en mémoire sur ce PC."
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          <TextBlock
              x:Name="Error"
              FontSize="13"
              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
              TextWrapping="Wrap"
              Visibility="Collapsed"
              IsTextSelectionEnabled="True" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
