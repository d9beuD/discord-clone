<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DiscordClone.Windows.Views">

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SidebarToggle" Content="Masquer la barre latérale" Click="OnToggleSidebar">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Alt" Key="S" />
          </Button.KeyboardAccelerators>
        </Button>
        <Button x:Name="MembersToggle" Content="Masquer les membres" Click="OnToggleMembers">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="M" />
          </Button.KeyboardAccelerators>
        </Button>
      </StackPanel>
      <TextBlock
          x:Name="StatusLabel"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80" />
        <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="240" MaxWidth="400" />
        <ColumnDefinition x:Name="SidebarSplitColumn" Width="1" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition x:Name="InspectorColumn" Width="260" MinWidth="220" MaxWidth="360" />
    </Grid.ColumnDefinitions>

      <views:ServerRailView Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" />

      <views:ChannelSidebarView
          x:Name="SidebarPane"
          Grid.Column="1"
          Background="{ThemeResource LayerFillColorDefaultBrush}" />
      <GridSplitter
          x:Name="SidebarSplitter"
          Grid.Column="2"
          Width="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

      <views:ChatView Grid.Column="3" />

      <views:MemberSidebarView
          x:Name="InspectorPane"
          Grid.Column="4"
          Background="{ThemeResource LayerFillColorDefaultBrush}" />
    </Grid>
  </Grid>
</UserControl>
