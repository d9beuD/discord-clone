<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DiscordClone.Windows.Views">

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SidebarToggle" Content="Masquer la barre latérale" Click="OnToggleSidebar" />
        <Button x:Name="MembersToggle" Content="Masquer les membres" Click="OnToggleMembers" />
      </StackPanel>
      <TextBlock
          x:Name="StatusLabel"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <!-- No GridSplitter: that type is UWP-only and absent from WinUI 3, so panes are
         fixed-width and only collapse. Accelerators are set in code-behind because the
         WinUI 3 markup compiler rejects comma-separated VirtualKeyModifiers text. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80" />
        <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="240" MaxWidth="400" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition x:Name="InspectorColumn" Width="260" MinWidth="220" MaxWidth="360" />
      </Grid.ColumnDefinitions>

      <views:ServerRailView Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" />

      <views:ChannelSidebarView
          x:Name="SidebarPane"
          Grid.Column="1"
          Background="{ThemeResource LayerFillColorDefaultBrush}" />

      <views:ChatView Grid.Column="2" />

      <views:MemberSidebarView
          x:Name="InspectorPane"
          Grid.Column="3"
          Background="{ThemeResource LayerFillColorDefaultBrush}" />
    </Grid>
  </Grid>
</UserControl>
