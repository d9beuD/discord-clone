<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.ServerRailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="using:DiscordClone.Bridge">

  <Grid Padding="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Button
        x:Name="AddServer"
        Grid.Row="0"
        HorizontalAlignment="Center"
        ToolTipService.ToolTip="Créer ou rejoindre un serveur"
        Visibility="Collapsed"
        Click="OnAddServer">
      <SymbolIcon Symbol="Add" />
    </Button>

    <ListView
        x:Name="ServerList"
        Grid.Row="1"
        Margin="0,8"
        SelectionChanged="OnSelectionChanged"
        ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="bridge:Server">
          <Grid
              Width="48"
              Height="48"
              ToolTipService.ToolTip="{x:Bind Name}">
            <Rectangle RadiusX="24" RadiusY="24" Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <TextBlock
                Text="{x:Bind Initials}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Button x:Name="ProfileButton" Grid.Row="2" HorizontalAlignment="Center" Click="OnOpenProfile" Visibility="Collapsed">
      <Grid Width="36" Height="36">
        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <TextBlock
            x:Name="ProfileInitials"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
