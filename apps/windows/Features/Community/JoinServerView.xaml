<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.JoinServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Width="420" Spacing="14" Padding="4,8">
    <TextBlock Text="Nouveau serveur" FontSize="14" FontWeight="SemiBold" />
    <TextBox x:Name="GuildName" Header="Nom du serveur" TextChanged="OnChanged" />
    <Button x:Name="CreateButton" Content="Créer le serveur" Click="OnCreate" IsEnabled="False" />

    <Border Height="1" Margin="0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

    <TextBlock Text="Invitation" FontSize="14" FontWeight="SemiBold" />
    <TextBox x:Name="InviteToken" Header="Code d’invitation" TextChanged="OnChanged" />
    <Button x:Name="JoinButton" Content="Rejoindre le serveur" Click="OnJoin" IsEnabled="False" />

    <ProgressRing x:Name="Busy" Width="18" Height="18" HorizontalAlignment="Left" IsActive="False" />
    <TextBlock
        x:Name="Error"
        FontSize="12"
        TextWrapping="Wrap"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        Visibility="Collapsed" />
  </StackPanel>
</UserControl>
