<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.CommunityManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Width="620" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock
        x:Name="Error"
        Grid.Row="0"
        FontSize="12"
        TextWrapping="Wrap"
        Visibility="Collapsed"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

    <TabView x:Name="Tabs" Grid.Row="1" IsAddTabButtonVisible="False">
      <TabView.TabItems>
        <TabViewItem Header="Serveur" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="ServerPanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Salons" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="ChannelPanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Membres" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="MemberPanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Rôles" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="RolePanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Invitations" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="InvitePanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Permissions" IsClosable="False">
          <ScrollViewer Padding="4,12" MaxHeight="460">
            <StackPanel x:Name="OverridePanel" Spacing="10" />
          </ScrollViewer>
        </TabViewItem>
      </TabView.TabItems>
    </TabView>
  </Grid>
</UserControl>
