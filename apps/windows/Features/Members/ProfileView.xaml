<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Width="300" Spacing="12" Padding="8,16">
    <Grid Width="76" Height="76" HorizontalAlignment="Center">
      <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
      <TextBlock
          x:Name="Initials"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="24"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Grid>
    <TextBlock x:Name="DisplayName" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
    <TextBlock x:Name="Bio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <TextBlock x:Name="Kind" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
