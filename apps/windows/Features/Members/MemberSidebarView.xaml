<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiscordClone.Windows.Views.MemberSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="using:DiscordClone.Bridge">

  <UserControl.Resources>
    <DataTemplate x:Key="MemberRow" x:DataType="bridge:Member">
      <Button
          Padding="0"
          Margin="0,2"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left"
          Background="Transparent"
          Click="OnOpenMember"
          Tag="{x:Bind User}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Grid Width="32" Height="32">
            <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <TextBlock
                Text="{x:Bind User.Initials}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                FontWeight="SemiBold" />
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind User.DisplayName}" FontSize="13" FontWeight="Medium" />
            <TextBlock
                Text="{x:Bind Role}"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20">
      <TextBlock Text="Membres" FontSize="15" FontWeight="SemiBold" />
      <TextBlock
          x:Name="Count"
          HorizontalAlignment="Right"
          FontSize="13"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

    <ScrollViewer Grid.Row="2" Padding="12,16">
      <StackPanel Spacing="16">
        <StackPanel x:Name="OnlineSection" Spacing="4">
          <TextBlock x:Name="OnlineHeader" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
          <ItemsControl x:Name="OnlineList" ItemTemplate="{StaticResource MemberRow}" />
        </StackPanel>
        <StackPanel x:Name="OfflineSection" Spacing="4">
          <TextBlock x:Name="OfflineHeader" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
          <ItemsControl x:Name="OfflineList" ItemTemplate="{StaticResource MemberRow}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
