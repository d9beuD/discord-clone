<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiscordClone.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DiscordClone.Windows.Views"
    Title="Discord Clone">

  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>

  <!-- Root stays transparent so Mica Alt reads through; panes supply the content layer. -->
  <Grid x:Name="RootHost" MinWidth="900" MinHeight="600" Background="Transparent">
    <views:LoginView x:Name="LoginPane" Visibility="Collapsed" />
    <views:WorkspaceView x:Name="WorkspacePane" Visibility="Collapsed" />
  </Grid>
</Window>
